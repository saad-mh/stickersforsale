# Every setting is optional. A missing one only turns off what depends on it.

# Your own phone number (not the bot's), with country code, digits only.
# Lets you command the bot outside the group.
OWNER_NUMBER=

# The group whose members can use the bot and where stickers go.
# Leave empty on first run: the bot lists your group IDs after connecting.
GROUP_JID=

# Port for the local web page, or "off".
PORT=3000

# Name shown in the sticker details.
STICKER_NAME=S.

# Spare Instagram account only: a cookies.txt path, or a browser such as firefox:/path/to/profile
IG_COOKIES=

# Only if ffmpeg is somewhere unusual (ffprobe must sit next to it).
FFMPEG_PATH=
